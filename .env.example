# SafeMove Platform — Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate.

# -------------------------------------------------------------
# General Application Settings
# -------------------------------------------------------------
APP_NAME=SafeMove API
VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# -------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------------------------
POSTGRES_DB=safemove
POSTGRES_USER=safemove
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Async Database Connection URL
# When running via Docker Compose, use host 'postgres'
# When running backend locally without Docker, use host 'localhost'
DATABASE_URL=postgresql+asyncpg://safemove:change-this-secure-password@postgres:5432/safemove

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cross-Origin Resource Sharing (CORS) — Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------
# Storage & Model Asset Paths
# -------------------------------------------------------------
# Path inside container where uploaded videos are persisted
VIDEO_STORAGE_PATH=/app/storage/videos

# MediaPipe Pose Landmarker model task file path
POSE_MODEL_PATH=/app/app/ml/pose/pose_landmarker_lite.task

# Base data directory for datasets and ML models
DATA_DIR=/app/data

# -------------------------------------------------------------
# Frontend Configuration (Next.js)
# -------------------------------------------------------------
# Browser-facing API endpoint URL accessed from the user's browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=SafeMove
