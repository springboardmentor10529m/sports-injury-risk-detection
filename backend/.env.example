# Application Configuration
PROJECT_NAME="Sports Injury Risk Detection API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=sports_injury_db

# Custom Database URL (Optional: Overrides individual POSTGRES_* settings if set)
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/sports_injury_db

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Security & JWT Authentication (Placeholders for Phase 2)
SECRET_KEY=generate_a_secure_random_32_byte_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth 2.0 / OpenID Connect Google Credentials (Placeholders for Phase 2)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
