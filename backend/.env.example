# PostgreSQL connection string (required)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/sports_injury_db

# Comma-separated allowed frontend origins for CORS (required in production)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server port (Render/Heroku set this automatically)
PORT=8000
