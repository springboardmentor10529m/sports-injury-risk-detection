# Copy this file to .env and adjust as needed.

# Default: local SQLite file, zero setup required.
# For production/spec-compliant Postgres, use e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/injury_guard
DATABASE_URL=sqlite:///./injury_guard.db

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=300

# Frames per second to sample from uploaded video for pose estimation.
# Lower = faster processing, higher = more temporal resolution.
POSE_SAMPLE_FPS=10

POSE_MODEL_PATH=./app/ml_models/pose_landmarker_full.task

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
